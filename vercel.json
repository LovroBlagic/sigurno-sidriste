{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev",
  "buildCommand": "",
  "outputDirectory": "web",
  "functions": {
    "api/*.js": { "includeFiles": "web/data/**", "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/mcp", "destination": "/api/mcp" }],
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
